{
  "name": "tourgirls",
  "private": true,
  "version": "1.0.0",
  "description": "TourGirls: API de atracciones (NestJS + PostgreSQL), servicio de autenticaciÃ³n y portal web.",
  "workspaces": [
    "packages/domain",
    "packages/data-management",
    "packages/business",
    "packages/contracts",
    "packages/data-access",
    "apps/api",
    "apps/auth"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b apps/api apps/auth",
    "clean": "tsc -b apps/api apps/auth --clean",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "db:local": "node tools/local-db.mjs",
    "migration:generate": "npm run build && typeorm migration:generate -d packages/data-access/dist/data-source.js",
    "start:api": "node apps/api/dist/main.js",
    "start:auth": "node apps/auth/dist/main.js",
    "lint": "tsc -b apps/api apps/auth --noEmit"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "^0.25.12",
    "jest": "^29.7.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.4",
    "typescript": "~5.8.3"
  }
}
