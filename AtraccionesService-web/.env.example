# Copia a `.env.local` para sobrescribir .env.development / .env.production en tu máquina.

# URL del API (sin /api/v1; el cliente lo añade).
VITE_API_URL=http://localhost:5276

# Servicio de autenticación (registro e inicio de sesión).
VITE_AUTH_URL=http://localhost:5280

# Origen del catálogo: auto | api | demo
#   auto -> API cuando hay sesión (el contrato exige attractions:read), catálogo de demostración sin sesión.
#   api  -> siempre el API.
#   demo -> siempre el catálogo local de demostración (las reservas y compras siguen usando el API).
VITE_CATALOG_SOURCE=auto
