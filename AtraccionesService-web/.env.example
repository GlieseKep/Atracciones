# URL base del API (incluye el prefijo /api/v1 del contrato).
VITE_API_BASE_URL=http://localhost:5276/api/v1

# Origen del catálogo: auto | api | demo
#   auto -> API cuando hay sesión OAuth2 (el contrato exige attractions:read), catálogo de demostración sin sesión.
#   api  -> siempre el API (sin sesión, el catálogo pedirá iniciar sesión).
#   demo -> siempre el catálogo local de demostración (las reservas y compras siguen usando el API).
VITE_CATALOG_SOURCE=auto

# OAuth2 Authorization Code + PKCE (cliente público: no hay client secret).
VITE_OAUTH_AUTHORIZATION_URL=https://auth.booking-hub.com/oauth2/authorize
VITE_OAUTH_TOKEN_URL=https://auth.booking-hub.com/oauth2/token
VITE_OAUTH_LOGOUT_URL=
VITE_OAUTH_CLIENT_ID=atracciones-web
VITE_OAUTH_AUDIENCE=atracciones-api
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OAUTH_SCOPES=openid profile email attractions:read attractions:book attractions:cancel
