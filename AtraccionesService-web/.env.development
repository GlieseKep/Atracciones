# Valores para `npm run dev` contra el entorno local (start-local.ps1).
# Emisor OAuth2 de desarrollo: tools/dev-oauth/server.mjs (no usar en producción).
VITE_API_BASE_URL=http://localhost:5276/api/v1
VITE_CATALOG_SOURCE=auto
VITE_OAUTH_AUTHORIZATION_URL=http://localhost:5280/authorize
VITE_OAUTH_TOKEN_URL=http://localhost:5280/token
VITE_OAUTH_LOGOUT_URL=http://localhost:5280/logout
VITE_OAUTH_CLIENT_ID=atracciones-web
VITE_OAUTH_AUDIENCE=atracciones-api
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OAUTH_SCOPES=openid profile email attractions:read attractions:book attractions:cancel attractions:write
