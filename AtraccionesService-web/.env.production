# Valores para `npm run build` (despliegue en Azure). Cambia los nombres si tus App Services se llaman distinto.
# No son secretos. El workflow de GitHub Actions puede sobrescribirlos con variables del repositorio.
VITE_API_URL=https://tourgirls-api.azurewebsites.net
VITE_AUTH_URL=https://tourgirls-auth.azurewebsites.net
VITE_CATALOG_SOURCE=auto
