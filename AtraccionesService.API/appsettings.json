{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "OAuth2": {
      "Authority": "https://auth.booking-hub.com",
      "Issuer": "https://auth.booking-hub.com",
      "Audience": "atracciones-api",
      "AuthorizationUrl": "https://auth.booking-hub.com/oauth2/authorize",
      "TokenUrl": "https://auth.booking-hub.com/oauth2/token",
      "RequireHttpsMetadata": true,
      "SwaggerClientId": ""
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "OpenApi": {
    "Enabled": false
  },
  "Database": {
    "Provider": "SqlServer",
    "ConnectionStringName": "Atracciones",
    "ApplyMigrations": false,
    "Seed": {
      "Catalog": false,
      "Ecommerce": false
    }
  },
  "Application": {
    "TimeZone": "America/Guayaquil",
    "HoldMinutes": 15,
    "MaxPaymentAttemptsPerOrder": 3,
    "IdempotencyRetentionHours": 24
  }
}
