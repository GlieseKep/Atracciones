@host = http://localhost:5276
@api = {{host}}/api/v1
# Access token emitido por el issuer OAuth2 (Authorization Code + PKCE). No guardar tokens reales en este archivo.
@token = <ACCESS_TOKEN>
@attractionId = 00000000-0000-0000-0000-000000000001
@orderId = 00000000-0000-0000-0000-000000000002

### Health (sin autenticación)
GET {{host}}/health

### Búsqueda de atracciones
POST {{api}}/atracciones/search
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currency": "USD",
  "countries": ["EC"],
  "dates": { "startDate": "2026-12-01", "endDate": "2026-12-31" },
  "rows": 20,
  "sort": { "by": "most_popular" }
}

### Listado paginado
GET {{api}}/atracciones?limit=10&offset=0
Authorization: Bearer {{token}}

### Disponibilidad
GET {{api}}/atracciones/{{attractionId}}/availability?date=2026-12-15
Authorization: Bearer {{token}}

### Crear reserva
POST {{api}}/atracciones/{{attractionId}}/reservations
Authorization: Bearer {{token}}
Idempotency-Key: 3f0c7a8e-1b2d-4c5e-9f60-7a8b9c0d1e2f
Content-Type: application/json

{
  "date": "2026-12-15",
  "time": "09:30",
  "ticketCount": 2,
  "customerName": "Ana Pérez",
  "customerEmail": "ana@ejemplo.com"
}

### Historial de reservas
GET {{api}}/atracciones/reservations?limit=20&offset=0&sort=-date
Authorization: Bearer {{token}}

### Aprovisionar perfil local (sub/email se toman del token)
POST {{api}}/auth/register
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "billingName": "Ana Pérez",
  "billingEmail": "facturacion@ejemplo.com",
  "billingAddress": "Av. Amazonas 123, Quito",
  "taxId": "1712345678"
}

### Perfil
GET {{api}}/users/me
Authorization: Bearer {{token}}

### Cliente
GET {{api}}/customers/me
Authorization: Bearer {{token}}

### Actualizar facturación
PUT {{api}}/customers/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "billingName": "Ana Pérez",
  "billingEmail": "facturacion@ejemplo.com",
  "billingAddress": "Av. Amazonas 123, Quito",
  "taxId": "1712345678",
  "paymentMethodReference": "sim-card-01"
}

### Compra directa con pago simulado
POST {{api}}/attractions/{{attractionId}}/purchase
Authorization: Bearer {{token}}
Idempotency-Key: 9b1d3c5e-7f8a-4b2c-8d0e-1f2a3b4c5d6e
Content-Type: application/json

{
  "date": "2026-12-15",
  "time": "09:30",
  "quantity": 2,
  "paymentMethod": "CARD"
}

### Crear pedido pendiente de pago
POST {{api}}/orders
Authorization: Bearer {{token}}
Idempotency-Key: 5a6b7c8d-9e0f-4a1b-8c2d-3e4f5a6b7c8d
Content-Type: application/json

{
  "attractionId": "{{attractionId}}",
  "date": "2026-12-15",
  "time": "09:30",
  "quantity": 2
}

### Consultar pedido (incluye estado del pago simulado)
GET {{api}}/orders/{{orderId}}
Authorization: Bearer {{token}}

### Eventos del pedido
GET {{api}}/orders/{{orderId}}/events
Authorization: Bearer {{token}}

### Simular pago
POST {{api}}/payments/simulations
Authorization: Bearer {{token}}
Idempotency-Key: 1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e5f
Content-Type: application/json

{
  "orderId": "{{orderId}}",
  "paymentMethod": "CARD",
  "amount": 90.00,
  "currency": "USD"
}

### Cancelar pedido
POST {{api}}/orders/{{orderId}}/cancel
Authorization: Bearer {{token}}
Idempotency-Key: 7e8f9a0b-1c2d-4e3f-8a5b-6c7d8e9f0a1b
Content-Type: application/json

{
  "reason": "Cambio de planes"
}
