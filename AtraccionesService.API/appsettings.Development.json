{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Authentication": {
    "OAuth2": {
      "Authority": "http://localhost:5280",
      "Issuer": "https://localhost/dev-issuer",
      "Audience": "atracciones-api",
      "AuthorizationUrl": "http://localhost:5280/authorize",
      "TokenUrl": "http://localhost:5280/token",
      "RequireHttpsMetadata": false,
      "SwaggerClientId": "atracciones-swagger"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:5173" ]
  },
  "ConnectionStrings": {
    "Atracciones": "Data Source=atracciones-dev.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "ApplyMigrations": true,
    "Seed": {
      "Catalog": true,
      "Ecommerce": true,
      "AvailabilityDays": 30
    }
  }
}
